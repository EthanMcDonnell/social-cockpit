# Copy this file to `.env` and fill in your values.
#
# NOT `.env.local` — the token manager reads and rewrites `.env` specifically
# (src/lib/token/manager.ts), and this file used to say otherwise.
#
# Every variable the app reads is declared in src/lib/config.ts, which validates
# them at startup. A required variable that is missing, or any value that cannot
# be parsed, stops the server at boot with the full list of problems rather than
# failing later inside a request. Keep the two files in step.
#
# Values that bound how many DMs can go out are deliberately NOT here. They are
# constants in src/lib/automation-sender.ts, so no line in this file can raise
# the send rate. Posting cadence (times of day, posts per day) is not here
# either — it lives in the app_settings table and is edited while the server
# runs. See src/lib/schedule/settings.ts.


# ─────────────────────────────────────────────────────────────────────────────
# Instagram — REQUIRED. The server will not start without these two.
# ─────────────────────────────────────────────────────────────────────────────

# Your Instagram Business/Creator account ID
INSTAGRAM_ACCOUNT_ID=

# Long-lived access token (valid ~60 days, refreshed automatically before expiry)
INSTAGRAM_ACCESS_TOKEN=

# App secret — optional, required only for exchanging short-lived tokens
INSTAGRAM_APP_SECRET=

# ISO date (YYYY-MM-DD) when the access token expires.
# The token manager reads this to show health status in the sidebar
# and writes a new date here after each refresh.
TOKEN_EXPIRES_AT=2026-06-07

# How often to check the token's age, and how close to expiry to refresh at.
# Optional. Defaults: 12h, 10 days.
TOKEN_REFRESH_INTERVAL_MS=
TOKEN_REFRESH_THRESHOLD_DAYS=


# ─────────────────────────────────────────────────────────────────────────────
# Scheduling — the calendar, the publishing worker, and the laptop API
# ─────────────────────────────────────────────────────────────────────────────

# Master kill switch for the publishing worker. "true" or "false" only.
# Defaults to true. Set it to false on any instance that is not production, so
# that even a mispointed DB_PATH cannot publish to a real account.
SCHEDULER_ENABLED=

# Dry run: walks the whole state machine but never calls a platform API.
# "true" or "false" only. Defaults to false.
SCHEDULE_DRY_RUN=

# Bearer token for /api/schedule/*. When UNSET the scheduling API is
# UNAUTHENTICATED — fine while the port is localhost-only, not otherwise.
# The MCP server must be given the same value.
SCHEDULE_API_TOKEN=

# Fallback display timezone (IANA, e.g. Australia/Brisbane). Only consulted when
# app_settings holds no stored timezone; the in-app setting wins.
SCHEDULE_TIMEZONE=

# Worker poll cadence, ms. Optional, defaults to 30000.
SCHEDULE_INTERVAL_MS=

# How late a job may fire before it is abandoned instead of published, minutes.
# Optional, defaults to 60.
SCHEDULE_GRACE_MINUTES=

# Where browser uploads land. Optional, defaults to ./data/staged.
SCHEDULE_MEDIA_DIR=

# Local-disk ceiling for owned staged media, bytes. Optional, defaults to 20 GiB.
SCHEDULE_MEDIA_CAP_BYTES=

# Confines which paths the local-publish endpoint may read. When unset, ANY
# absolute path on this machine can be published. Set it if the port is ever
# reachable off-localhost.
LOCAL_MEDIA_ROOT=


# ─────────────────────────────────────────────────────────────────────────────
# YouTube — optional. Leave the whole section blank to disable.
# ─────────────────────────────────────────────────────────────────────────────

# Read-path API key (channel stats, video lists)
YOUTUBE_API_KEY=

YOUTUBE_CHANNEL_ID=

# Optional. Skips one API call per video fetch when set.
YOUTUBE_UPLOADS_PLAYLIST_ID=

# OAuth client for uploads. Set BOTH or NEITHER — a half-set pair is a boot
# error. Note the client must be a "Web application" type in production; see
# docs/future-considerations.md.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# Override the callback URL when the public origin differs from what Next sees
# (e.g. behind a proxy). Optional — normally derived from the request origin.
YOUTUBE_OAUTH_REDIRECT_URI=

# Written automatically by the OAuth callback once you connect the channel.
# Leave blank during setup.
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Whether the channel has passed Google's API audit. "true" or "false" only.
# Defaults to false, and the default is the safe one: until this is true every
# upload is forced UNLISTED regardless of the privacy you choose. Only set it to
# true once Google has actually confirmed the audit.
YOUTUBE_AUDIT_PASSED=


# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 media hosting — optional. Set all four or none.
# ─────────────────────────────────────────────────────────────────────────────

# ── Terraform bootstrap token — TEMPORARY, single-use only ──
# Needs Account -> Workers R2 Storage: Edit + Account API Tokens: Edit (the
# latter is required because Terraform creates the R2 data token below, not
# because the app needs it). Create it immediately before running
# `./infra/setup.sh` / `terraform apply`, then REVOKE IT in the dashboard right
# after — don't leave it active. See the comment above `cloudflare_api_token
# "r2_media"` in infra/main.tf for the full reasoning. The running app never
# reads this value; it's stored here purely as a record.
CLOUDFLARE_API_TOKEN=

# auto-set by infra/setup.sh
R2_ACCOUNT_ID=

# auto-set by infra/setup.sh
R2_ACCESS_KEY_ID=

# auto-set by infra/setup.sh
R2_SECRET_ACCESS_KEY=

# auto-set by infra/setup.sh
R2_BUCKET=social-cockpit-media

# not auto-set — optional, defaults to 8 GiB if omitted
R2_CAP_BYTES=8589934592


# ─────────────────────────────────────────────────────────────────────────────
# Transcription — optional
# ─────────────────────────────────────────────────────────────────────────────

# Path to a Python interpreter with faster-whisper installed. When unset,
# transcription is treated as not configured and never runs — there is no
# fallback to a system python, which would not have the dependencies.
TRANSCRIPTION_PYTHON=

# faster-whisper model name. Optional, defaults to "small".
TRANSCRIPTION_MODEL=


# ─────────────────────────────────────────────────────────────────────────────
# Storage paths — optional, all default under ./data
# ─────────────────────────────────────────────────────────────────────────────

# The main database: automation flows, scheduled posts, app settings.
DB_PATH=

# Materialized Meta API cache. Deliberately a separate file from DB_PATH.
CACHE_DB_PATH=

# Transcripts. Also deliberately separate.
TRANSCRIPTS_DB_PATH=


# ─────────────────────────────────────────────────────────────────────────────
# MCP server (mcp/) — read by that process, not by the Next app
# ─────────────────────────────────────────────────────────────────────────────

# Where the cockpit is reachable. Optional, defaults to http://localhost:3000.
COCKPIT_URL=
