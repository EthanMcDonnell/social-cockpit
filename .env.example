# Instagram Graph API credentials
# Copy this file to .env.local and fill in your values.

# Your Instagram Business/Creator account ID
INSTAGRAM_ACCOUNT_ID=

# Long-lived access token (valid ~60 days, refresh before expiry)
INSTAGRAM_ACCESS_TOKEN=

# App secret — required only for exchanging short-lived tokens
INSTAGRAM_APP_SECRET=

# ISO date (YYYY-MM-DD) when the access token expires
# The token manager reads this to show health status in the sidebar
# and writes a new date here after each refresh.
TOKEN_EXPIRES_AT=2026-06-07
